# ---- storage -------------------------------------------------------------------------------------------------
# Render/any host: use a hosted MongoDB (e.g. Atlas). "memory://" loses all data on every restart (fine for demos/tests only).
DATABASE_URL=mongodb://localhost:27017/wingo
# required header X-API-Key for every write endpoint; leave empty only on localhost
ADMIN_API_KEY=change-me
# only needed if the browser calls the backend directly. Via the Vercel /api rewrite it is same-origin.
ALLOWED_ORIGINS=http://localhost:8000
# loads SEED_CSV when the DB is empty
AUTO_SEED=true
SEED_CSV=data/wingo_docx_clean.csv
ASSUMED_SCHEDULE=true
# optional token sent as Authorization header to SYNC_SOURCE_URL
SYNC_AUTH_HEADER=
AUTO_BACKTEST=true

# ---- live data source: OFF unless you have an API you are allowed to use ---------------------------------------
SYNC_ENABLED=false
# e.g. https://api.provider.example/v1/wingo/history   (JSON, GET)
SYNC_SOURCE_URL=
# dot path to the list inside the JSON, e.g. data.list ("" if the root is the list)
SYNC_LIST_PATH=
# field with the round / period id (digits)
SYNC_PERIOD_FIELD=
# field with the drawn number 0-9
SYNC_NUMBER_FIELD=
# field with the draw time (ISO-8601, or epoch seconds/ms). REQUIRED for the countdown.
SYNC_TIME_FIELD=
# e.g. {"Authorization":"Bearer ..."}  - never commit real values
SYNC_HEADERS_JSON=
# minimum 10. Be gentle with the provider; respect its rate limits.
SYNC_INTERVAL_SECONDS=10
# used only while a round has just ended and its result is not in yet
SYNC_FAST_INTERVAL_SECONDS=5
SYNC_RESPECT_ROBOTS=true
SYNC_ALLOW_GAPS=false
# needed once if you start syncing on top of history that has no period ids
SYNC_START_AFTER_PERIOD=

# ---- period clock (the schedule is VERIFIED from stored timestamps, never assumed) -------------------------------
PERIOD_SECONDS=60
# zone of timestamps WITHOUT an offset, e.g. Asia/Kolkata. Wrong value => "timestamp in the future" => no countdown
SOURCE_TIMEZONE=UTC
# "end" = the timestamp is when the round finished; "start" = when it began
TIMESTAMP_MEANS=end
CLOCK_TOLERANCE_SECONDS=5
CLOCK_MIN_SAMPLES=5
# after the boundary: "Awaiting result" for this long, then "Result overdue"
LATE_GRACE_SECONDS=20
UI_POLL_SECONDS=10
